# Copy this file to .env and replace every placeholder before running.
POSTGRES_DB=fadak
POSTGRES_USER=fadak
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://fadak:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/fadak

# Shared starter token used by the existing accounting-panel contract. Keep private; use 32+ random characters.
FADAK_PANEL_TOKEN=REPLACE_WITH_A_LONG_RANDOM_PRIVATE_TOKEN_AT_LEAST_32_CHARS

# Comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
WEB_PORT=8080

# Optional public contact details
FADAK_PUBLIC_PHONE=
FADAK_PUBLIC_ADDRESS=

# Payment remains disabled until a real merchant account and the official gateway callback flow are configured.
PAYMENT_PROVIDER=disabled
ZARINPAL_MERCHANT_ID=

# Optional. The signed POS webhook returns 503 until a long random secret is configured.
POS_WEBHOOK_SECRET=
