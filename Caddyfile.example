# Example for a public domain with automatic HTTPS.
# Point example.com to the server and replace this host with the real domain.
example.com {
	encode zstd gzip

	@panelRoot path /panel
	redir @panelRoot /panel/ 308

	@api path /api/* /health* /docs* /redoc* /openapi.json
	handle @api {
		reverse_proxy api:8000
	}

	handle_path /panel/* {
		root * /srv/apps/panel
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/apps/storefront
		try_files {path} /index.html
		file_server
	}
}
